{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows (MSVC, Visual Studio 2022)",
      "description": "Native build on Windows. Untested in this repository; see README.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux (GCC, native)",
      "description": "Native build on Linux or WSL with the host GCC toolchain.",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-arm64-cross",
      "displayName": "Linux ARM64 cross-compile (NanoPi)",
      "description": "Cross-compile for aarch64 Linux. Needs the aarch64 GNU toolchain and host protoc/grpc_cpp_plugin on PATH.",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-arm64-cross",
      "configurePreset": "linux-arm64-cross"
    }
  ]
}
